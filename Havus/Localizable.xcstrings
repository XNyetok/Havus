    },
    "Havus kamu udah yang terbaru" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Havus is up to date"
          }
        }
      }
    },
    "Havus nggak bakal nyentuh file dan folder di sini, termasuk semua isinya. Semuanya nggak muncul di hasil pindai, dan nggak bakal dipindah ke Tong Sampah atau dihapus." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Havus never touches the files and folders listed here, or anything inside them. They don't show up in scan results, and they're never moved to the Trash or deleted."
          }
        }
      }
    },
    "Havus nggak bisa matiin %@" : {
