// Personal build settings. Optional.
//
//   cp Config/Local.xcconfig.example Config/Local.xcconfig
//
// Config/Local.xcconfig is gitignored, so your Team ID never ends up in the public repo.
//
// Why bother? macOS ties the Full Disk Access permission to the app's signature.
// Ad-hoc builds get a new signature on every build, so the permission keeps resetting.
// Signing with your own team (a free Apple ID works) keeps it stable.

// Your Team ID: Xcode → Settings → Accounts, or https://developer.apple.com/account
DEVELOPMENT_TEAM = ABCDE12345
CODE_SIGN_IDENTITY = Apple Development
